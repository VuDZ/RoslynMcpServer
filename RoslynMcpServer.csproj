<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64;linux-arm64;linux-musl-x64</RuntimeIdentifiers>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Set up the NuGet package to be an MCP server -->
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <!-- Publish stays self-contained via PublishSelfContained + RID. Regular build is FDD so
         LifecycleTestHost (framework-dependent) can reference this project (NETSDK1151). -->
    <SelfContained>false</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Server GC (with DATAS, the .NET 10 default) cut GC pauses of the first search on Roslyn.slnx
         from 8 s to 2 s and load + first search by 18%, for 14-19% more working set
         (branch research/workspace-load-performance,
         docs/workspace-load-performance/epoch-0-stage-measurement/evidence/task-12-server-gc-first-search.md).
         Workstation GC collected every 48 MB of gen0 and promoted the retained syntax trees each time.
         DOTNET_gcServer=0 in the environment restores workstation GC without a rebuild. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- Set recommended package metadata -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>RoslynMcpServer</PackageId>
    <Version>1.5.15</Version>
    <AssemblyVersion>1.5.15.0</AssemblyVersion>
    <FileVersion>1.5.15.0</FileVersion>
    <PackageTags>AI; MCP; server; stdio</PackageTags>
    <Description>An MCP server using the MCP C# SDK.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RoslynMcpServer.Tests" />
    <InternalsVisibleTo Include="RoslynMcpServer.LifecycleTestHost" />
  </ItemGroup>
  <!-- Include additional files for browsing the MCP server. -->
  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="PRIVACY.md" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- OpenCode installer script and agent rules template (copied next to the published binary). -->
  <ItemGroup>
    <None Include="install2opencode.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="opencode.json.sample" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="AGENTS.md.sample" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="publish-and-verify.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Keep Roslyn MEF parts when trimming self-contained builds -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.Workspaces" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.Features" />
    <TrimmerRootAssembly Include="Microsoft.CodeAnalysis.CSharp.Features" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="RoslynMcpServer.Tests\**" />
    <None Remove="RoslynMcpServer.Tests\**" />
    <Compile Remove="RoslynMcpServer.LifecycleTestHost\**" />
    <None Remove="RoslynMcpServer.LifecycleTestHost\**" />
    <!-- The sample plugin is a separate project of this repository. Its sources, including the
         generated .cs under its obj directory, are not part of the host assembly. -->
    <Compile Remove="samples\**" />
    <None Remove="samples\**" />
    <Compile Remove="spikes\**" />
    <None Remove="spikes\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="10.0.1.8346" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.6.3" PrivateAssets="all" ExcludeAssets="runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <!-- Roslyn's persistent index storage. Workspaces 5.9.0 references SQLitePCLRaw.batteries_v2 2.3.5.0
         (key df579d6b11135638) without a NuGet dependency on it; that is the SQLite3MC build, not
         SQLitePCLRaw 2.x/3.x. Without it every server process rebuilt all indexes; with a warm cache the
         first search on Roslyn.slnx took 0.52 and 0.22 of the cold time and a third of the memory (task-14).
         Keep the version equal to Roslyn's reference: RoslynIndexStorageTests fails otherwise. -->
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.3.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <!-- Pin the transitive dependency from MSBuild tasks to the fix for CVE-2026-70162.
         https://github.com/advisories/GHSA-2fmv-rv2c-59x7 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
