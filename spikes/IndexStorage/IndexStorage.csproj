<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParallelSearch</RootNamespace>
    <AssemblyName>IndexStorage</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ParallelSearch measurement unchanged; only SQLite is added, so Roslyn's persistent storage can open. -->
    <Compile Include="../ParallelSearch/**/*.cs" Exclude="../ParallelSearch/bin/**;../ParallelSearch/obj/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <!-- Roslyn 5.9.0 references SQLitePCLRaw.batteries_v2 2.3.5.0 with token df579d6b11135638: the
         SQLite3MC build, not SQLitePCLRaw 2.x/3.x (other version line and signing key). -->
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.3.5" />
  </ItemGroup>
</Project>
