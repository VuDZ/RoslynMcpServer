<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ParallelSearch</RootNamespace>
    <AssemblyName>IndexStorage</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The ParallelSearch measurement unchanged; only SQLite is added, so Roslyn's persistent storage can open. -->
    <Compile Include="../ParallelSearch/**/*.cs" Exclude="../ParallelSearch/bin/**;../ParallelSearch/obj/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.7.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
    <!-- Match Roslyn's managed assembly identity and the server's native SQLite version. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[2.1.11]" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="[3.53.3]" />
  </ItemGroup>
</Project>
