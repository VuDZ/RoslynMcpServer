<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The scenario fixture is generated under results/ with its own sources and obj; keep it out of this build. -->
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);results/**;bin-fork/**;bin-fork-broken/**;bin-fork-gc/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
  <ItemGroup>
    <!-- The server-equivalent load and search of the other spikes, and the E0 workspace observation. -->
    <Compile Include="../ParallelSearch/MsBuildRegistration.cs;../ParallelSearch/SolutionLoader.cs;../ParallelSearch/DeclarationSearch.cs;../ParallelSearch/SearchMeasurement.cs;../ParallelSearch/WorkingSetSampler.cs;../ParallelSearch/Models/*.cs" />
    <Compile Include="../ParallelLoad/SolutionObservation.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.6.3" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
</Project>
