<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerOutput>$(MSBuildThisFileDirectory)..\..\bin\Release\net10.0</ServerOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(ServerOutput)\Microsoft.CodeAnalysis.dll" />
    <Reference Include="$(ServerOutput)\Microsoft.CodeAnalysis.CSharp.dll" />
    <Reference Include="$(ServerOutput)\Microsoft.CodeAnalysis.Workspaces.dll" />
    <Reference Include="$(ServerOutput)\Microsoft.CodeAnalysis.CSharp.Workspaces.dll" />
    <Reference Include="$(ServerOutput)\System.Composition.*.dll" />
  </ItemGroup>
</Project>
