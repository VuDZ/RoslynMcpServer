<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Framework-dependent x64: a self-contained win-x86 apphost made the suite pick
         Program Files (x86)\dotnet and hang inside `dotnet build` until an 8-minute RPC timeout. -->
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RoslynMcpServer.LifecycleTestHost</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RoslynMcpServer.csproj" />
  </ItemGroup>
</Project>
